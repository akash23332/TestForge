# Custom Judge0 image override
# Defaults to testforge/judge0:v1.13.1-arm64 on native ARM64 hosts, or judge0/judge0:v1.13.1 on x86_64
# JUDGE0_IMAGE=testforge/judge0:v1.13.1-arm64

# Database & Authentication Secrets for Dedicated Judge0 Runner
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace_with_strong_random_db_password_min_24_chars
POSTGRES_DB=judge0
REDIS_PASSWORD=replace_with_strong_random_redis_password_min_24_chars

# API Authentication Token (Must match RENDER_SANDBOX_API_KEY in TestForge Worker)
AUTHN_TOKEN=replace_with_strong_random_token_min_32_chars

# Authorization Token for administrative endpoints (/system_info)
AUTHZ_TOKEN=replace_with_strong_random_admin_token_min_32_chars
