PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/testforge
JWT_SECRET=super_secure_testforge_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=
LLM_API_KEY=

# Execution Provider Configuration:
# - 'mock': In-memory simulation provider (default fail-closed for production until runner provisioned)
# - 'render_sandbox': Dedicated Judge0 CE runner
# - 'local': In-process local execution (STRICTLY PROHIBITED IN PRODUCTION; requires ALLOW_LOCAL_EXECUTION=true)
EXECUTION_PROVIDER=mock
ALLOW_LOCAL_EXECUTION=false

# Dedicated Judge0 CE Runner Configuration (Used when EXECUTION_PROVIDER=render_sandbox)
RENDER_SANDBOX_ENDPOINT=https://runner.testforge.edu
RENDER_SANDBOX_API_KEY=your_cryptographically_secure_authn_token_min_32_chars
