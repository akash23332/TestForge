# ==============================================================================
# TestForge Backend-to-Runner Integration Configuration Template
# Environment: Render Background Worker & Web Service (Production / Staging)
# Target Runner: Dedicated Oracle Cloud Infrastructure (OCI) Ampere A1 ARM64 VM
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Provider Selection
# ------------------------------------------------------------------------------
# In production, this MUST be set to 'render_sandbox'.
# NOTE: 'local' execution is strictly blocked in production and will crash at boot.
# 'mock' execution is permitted for staging smoke tests, but will NEVER award marks in production.
EXECUTION_PROVIDER=render_sandbox

# ------------------------------------------------------------------------------
# 2. Remote Runner Connectivity
# ------------------------------------------------------------------------------
# Target URL for the isolated execution runner.
# Pattern A (Direct HTTPS via Caddy reverse proxy on VM):
#   RENDER_SANDBOX_ENDPOINT=https://runner-staging.yourdomain.com
# Pattern B (Private Mesh via Tailscale SOCKS5 proxy on Render):
#   RENDER_SANDBOX_ENDPOINT=http://100.x.y.z:2358
# Standard Judge0 aliases also supported:
RENDER_SANDBOX_ENDPOINT=https://runner-staging.yourdomain.com
JUDGE0_URL=https://runner-staging.yourdomain.com

# Authentication Token configured on the Judge0 runner (X-Auth-Token header).
# Must match JUDGE0_AUTH_TOKEN in deploy/judge0/.env on the runner host.
# NEVER commit real tokens to git. Generate with: openssl rand -hex 32
RENDER_SANDBOX_API_KEY=replace_with_high_entropy_secret_hex32_token
JUDGE0_API_KEY=replace_with_high_entropy_secret_hex32_token

# Optional secondary authorization token (X-Auth-User header)
RENDER_SANDBOX_AUTHZ_TOKEN=
JUDGE0_AUTHZ_TOKEN=

# ------------------------------------------------------------------------------
# 3. Connection and Timeout Governance
# ------------------------------------------------------------------------------
# Connection timeout (ms): Maximum time allowed to establish TCP/TLS connection with runner.
# Default: 5000ms
RUNNER_CONNECTION_TIMEOUT_MS=5000

# Response timeout (ms): Maximum time allowed for complete HTTP response from runner.
# Default: 10000ms (Must exceed max user code execution wall-time)
RUNNER_RESPONSE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. Private Mesh & Proxy Governance (Tailscale on Render)
# ------------------------------------------------------------------------------
# If running through a Tailscale Userspace proxy (e.g. SOCKS5 daemon on Render worker):
# TAILSCALE_PROXY=http://127.0.0.1:1056
# REQUIRE_PROXY=true (Enforces fail-closed: prevents accidental public fallback)
TAILSCALE_PROXY=
REQUIRE_PROXY=false

# ------------------------------------------------------------------------------
# 5. BullMQ Worker Capacity & Concurrency
# ------------------------------------------------------------------------------
# Concurrency limit for background submission evaluation jobs.
# On OCI Ampere A1 (2 OCPUs, 12 GB RAM), keep concurrency conservative (1-3)
# to avoid CPU starvation and isolate memory thrashing.
WORKER_CONCURRENCY=2

# Redis / Valkey URL for BullMQ job queue management
REDIS_URL=redis://127.0.0.1:6379
